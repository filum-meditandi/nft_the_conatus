{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resolution Tracker",
  "version": "1.0.0",
  "identifier": "com.resolutiontracker.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Resolution Tracker",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:resolutions.db"]
    }
  }
}
