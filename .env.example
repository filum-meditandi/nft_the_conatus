# =============================================================================
# PHENOMENOLOGICAL EVIDENCE SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# APPLICATION
# =============================================================================

# Environment: development, staging, or production
ENVIRONMENT=development

# Enable debug mode (disable in production!)
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://conatus:conatus@localhost:5432/phenomenological_evidence

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Test database (optional, for running tests)
# TEST_DATABASE_URL=postgresql://conatus:conatus@localhost:5432/phenomenological_evidence_test

# =============================================================================
# CRYPTOGRAPHY - CRITICAL SECURITY SETTINGS
# =============================================================================

# Master encryption key for PHI (Protected Health Information)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be 32 bytes, base64-encoded
# NEVER share this key or commit it to version control!
MASTER_ENCRYPTION_KEY=

# Server signing key for attestation chains (Ed25519 private key)
# Leave empty to generate automatically (stored in database)
# SERVER_SIGNING_KEY=

# Allow key rotation (set to true only during rotation process)
ALLOW_KEY_ROTATION=false

# Previous master keys for decrypting old data (comma-separated)
# Only needed during key rotation
# PREVIOUS_MASTER_KEYS=

# =============================================================================
# TWILIO (SMS INTEGRATION)
# =============================================================================

# Twilio credentials
# Get these from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Your Twilio phone number (E.164 format: +1234567890)
TWILIO_PHONE_NUMBER=

# SMS settings
SMS_ENABLED=true
SMS_RATE_LIMIT_PER_HOUR=100

# =============================================================================
# SECURITY
# =============================================================================

# Secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# HIPAA/PHI compliance settings
PHI_ENCRYPTION_REQUIRED=true
AUDIT_LOG_ENABLED=true

# =============================================================================
# HMM INFERENCE (PAIN TRAJECTORY ANALYSIS)
# =============================================================================

# Enable Hidden Markov Model pain trajectory inference
HMM_ENABLED=true
HMM_MIN_OBSERVATIONS=5
HMM_STATE_COUNT=4

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional, leave empty for console-only logging)
# LOG_FILE=/var/log/conatus/app.log

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable experimental features
FEATURE_VOICE_INPUT=false
FEATURE_NFT_MINTING=false
FEATURE_INTENTIONALITY_BRIDGE=false

# =============================================================================
# TESTING
# =============================================================================

# Enable testing mode (disables certain checks)
TESTING=false

# =============================================================================
# NOTES
# =============================================================================

# Production deployment checklist:
# [ ] Set ENVIRONMENT=production
# [ ] Set DEBUG=false
# [ ] Generate strong MASTER_ENCRYPTION_KEY
# [ ] Generate strong SECRET_KEY
# [ ] Configure production DATABASE_URL
# [ ] Set up Twilio credentials
# [ ] Review CORS_ORIGINS (whitelist only trusted domains)
# [ ] Enable AUDIT_LOG_ENABLED
# [ ] Set appropriate LOG_LEVEL (INFO or WARNING)
# [ ] Back up MASTER_ENCRYPTION_KEY securely (HSM/KMS recommended)
# [ ] Configure TLS/SSL certificates
# [ ] Set up database backups
# [ ] Review rate limiting settings
# [ ] Security audit of all settings

# HIPAA Compliance Notes:
# - MASTER_ENCRYPTION_KEY must be stored in HSM or KMS in production
# - Enable AUDIT_LOG_ENABLED to track all PHI access
# - Ensure DATABASE_URL uses encrypted connection (SSL mode)
# - Regular key rotation required (document your schedule)
# - Maintain access logs for 6 years minimum
